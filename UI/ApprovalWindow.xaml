<Window x:Class="SysOptimizer.UI.ApprovalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SysOptimizer - review recommendations"
        Height="650" Width="820"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="check off whatever you actually want to run. nothing happens until you hit approve — this is basically the whole safety model of the app, so take a sec and read the scripts before checking anything."
                   FontSize="13" TextWrapping="Wrap" Margin="0,0,0,12"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="RecommendationsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="6" Margin="0,0,0,10" Padding="12" Background="#FAFAFA">
                            <StackPanel>
                                <CheckBox IsChecked="{Binding IsApproved, Mode=TwoWay}" FontWeight="Bold" FontSize="14" VerticalContentAlignment="Center">
                                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap"/>
                                </CheckBox>
                                <TextBlock Text="{Binding Category}" FontStyle="Italic" Foreground="Gray" Margin="24,3,0,6"/>
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="24,0,0,6"/>
                                <TextBlock Text="{Binding WhyItHelps}" TextWrapping="Wrap" Margin="24,0,0,6" FontStyle="Italic" Foreground="#333333"/>
                                <TextBlock Margin="24,0,0,6" TextWrapping="Wrap">
                                    <Run Text="evidence: " FontWeight="SemiBold"/>
                                    <Run Text="{Binding Evidence, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding Flags}" Margin="24,0,0,6" Foreground="#555555" FontSize="12"/>
                                <TextBox Text="{Binding ExecutionScript, Mode=OneWay}"
                                         IsReadOnly="True" TextWrapping="Wrap"
                                         FontFamily="Consolas" FontSize="12"
                                         Background="#F0F0F0" Margin="24,4,0,0" Padding="6"
                                         BorderThickness="1" BorderBrush="#DDDDDD"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="CancelButton" Content="Approve none" Padding="14,6" Margin="0,0,10,0" Click="CancelButton_Click"/>
            <Button x:Name="ApproveButton" Content="Approve checked" Padding="14,6" FontWeight="Bold" Click="ApproveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
